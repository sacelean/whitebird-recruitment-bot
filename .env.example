DISCORD_TOKEN=pon_aqui_el_token_del_bot
DISCORD_CLIENT_ID=id_de_aplicacion
DISCORD_GUILD_ID=id_del_servidor
OFFICER_ROLE_IDS=id_rol_oficial,id_rol_guild_master
APPLY_CATEGORY_ID=id_categoria_applies
RAIDER_CATEGORY_ID=id_categoria_raiders
ENTRY_CHANNEL_ID=id_canal_entrada_para_transcripciones

# Mensajes opcionales (puedes personalizarlos)
APPLY_RECEIVED_MESSAGE=¡Hola {user}! Hemos recibido tu apply para {character} · {realm}. Los oficiales lo revisarán aquí.
# El mensaje de aceptación predeterminado es el texto de bienvenida del README.
# Si defines APPLY_ACCEPTED_MESSAGE en .env, ese texto reemplazará el predeterminado.
# Mensaje opcional de rechazo; admite {user}, {character}, {realm}, {server} y {channel}.
# El motivo que introduzca el oficial solo se guarda en la transcripción y no se envía por MD.
# APPLY_REJECTED_MESSAGE=Hola {user}, gracias por tu interés. En esta ocasión no podemos ofrecerte una plaza.

# Preguntas opcionales; si se omiten, se usan las preguntas predeterminadas
# APPLY_QUESTION_CHARACTER=Nombre de tu personaje principal
# APPLY_QUESTION_REALM=Reino
# APPLY_QUESTION_CLASS=Clase y especialización
# APPLY_QUESTION_EXPERIENCE=Experiencia en raids
# APPLY_QUESTION_AVAILABILITY=Disponibilidad y motivación para unirte

# Opcional: DATABASE_PATH=/app/data/whitebird-recruitment.sqlite
